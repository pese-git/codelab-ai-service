# =============================================================================
# CodeLab AI Service - Complete Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment
# This configuration includes settings for all services in the project

# =============================================================================
# ENVIRONMENT & SERVER CONFIGURATION
# =============================================================================
# Environment (development, staging, production)
ENVIRONMENT=development

# Auth Service Port
PORT=8003

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database (for Core Service and Langfuse)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codelab
POSTGRES_PORT=5432

# Core Application Database URL (async PostgreSQL)
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/codelab

# Langfuse Database URL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/langfuse

# Auth Service Database Configuration
# For SQLite (development/testing):
AUTH_SERVICE__DB_URL=sqlite:///data/auth.db
# For PostgreSQL (production):
# AUTH_SERVICE__DB_URL=postgresql://auth_user:auth_password@localhost:5432/auth_db
# For PostgreSQL with asyncpg driver (recommended for async operations):
# AUTH_SERVICE__DB_URL=postgresql+asyncpg://auth_user:auth_password@localhost:5432/auth_db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Connection Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis-secure-password-change-in-production
REDIS_DB=0
REDIS_URL=redis://:redis-secure-password-change-in-production@redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Auth Service Redis URL
AUTH_SERVICE__REDIS_URL=redis://redis:6379/1

# Core Application Redis URL
APP_REDIS_URL=redis://redis:6379/0

# =============================================================================
# QDRANT CONFIGURATION (Vector Database)
# =============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_URL=http://qdrant:6333

# =============================================================================
# MINIO CONFIGURATION (S3-compatible Storage)
# =============================================================================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=langfuse
MINIO_REGION=auto

# =============================================================================
# CLICKHOUSE CONFIGURATION
# =============================================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# =============================================================================
# AUTH SERVICE CONFIGURATION
# =============================================================================
# JWT Settings
AUTH_SERVICE__JWT_ISSUER=https://auth.codelab.local
AUTH_SERVICE__JWT_AUDIENCE=codelab-api
AUTH_SERVICE__ACCESS_TOKEN_LIFETIME=900
AUTH_SERVICE__REFRESH_TOKEN_LIFETIME=2592000

# RSA Keys
AUTH_SERVICE__PRIVATE_KEY_PATH=/app/keys/private_key.pem
AUTH_SERVICE__PUBLIC_KEY_PATH=/app/keys/public_key.pem

# Security Settings
# AUTH_SERVICE__MASTER_KEY=your-secure-password-here  # If not set, a random password will be generated and logged
AUTH_SERVICE__ENABLE_RATE_LIMITING=true
AUTH_SERVICE__RATE_LIMIT_PER_IP=5
AUTH_SERVICE__RATE_LIMIT_PER_USERNAME=10
AUTH_SERVICE__BRUTE_FORCE_THRESHOLD=5
AUTH_SERVICE__BRUTE_FORCE_LOCKOUT_DURATION=900

# Registration & Password Reset
AUTH_SERVICE__REGISTRATION_RATE_LIMIT=10
AUTH_SERVICE__REQUIRE_EMAIL_CONFIRMATION=true
AUTH_SERVICE__SUGGEST_USERNAMES=true
AUTH_SERVICE__AUDIT_LOG_RETENTION_DAYS=90
AUTH_SERVICE__PASSWORD_RESET_REQUEST_LIMIT=3
AUTH_SERVICE__PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30

# Password Validation Rules
AUTH_SERVICE__PASSWORD_MIN_LENGTH=8
AUTH_SERVICE__PASSWORD_MAX_LENGTH=128
AUTH_SERVICE__PASSWORD_REQUIRE_UPPERCASE=true
AUTH_SERVICE__PASSWORD_REQUIRE_LOWERCASE=true
AUTH_SERVICE__PASSWORD_REQUIRE_DIGITS=true
AUTH_SERVICE__PASSWORD_REQUIRE_SPECIAL_CHARS=true
# Pattern for special characters (regex)
AUTH_SERVICE__PASSWORD_SPECIAL_CHARS_PATTERN=[!@#$%^&*(),.?\":{}|<>]

# SMTP Configuration for Email
# For development (MailHog):
AUTH_SERVICE__SMTP_HOST=mailhog
AUTH_SERVICE__SMTP_PORT=1025
AUTH_SERVICE__SMTP_USERNAME=
AUTH_SERVICE__SMTP_PASSWORD=
AUTH_SERVICE__SMTP_FROM_EMAIL=noreply@codelab.local
AUTH_SERVICE__SMTP_USE_TLS=false
# For production (e.g., SendGrid, AWS SES, Mailgun):
# AUTH_SERVICE__SMTP_HOST=smtp.sendgrid.net
# AUTH_SERVICE__SMTP_PORT=587
# AUTH_SERVICE__SMTP_USERNAME=apikey
# AUTH_SERVICE__SMTP_PASSWORD=your-sendgrid-api-key
# AUTH_SERVICE__SMTP_FROM_EMAIL=noreply@yourdomain.com
# AUTH_SERVICE__SMTP_USE_TLS=true

AUTH_SERVICE__SMTP_TIMEOUT=30
AUTH_SERVICE__SMTP_MAX_RETRIES=3
AUTH_SERVICE__SEND_WELCOME_EMAIL=true
AUTH_SERVICE__SEND_PASSWORD_RESET_EMAIL=true

# Swagger UI Configuration
AUTH_SERVICE__ENABLE_SWAGGER_UI=true

# Auth Service Logging
AUTH_SERVICE__LOG_LEVEL=DEBUG

# =============================================================================
# LANGFUSE CONFIGURATION
# =============================================================================
# NextAuth configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=langfuse-secret-change-me-in-production
SALT=langfuse-salt-change-me-in-production
ENCRYPTION_KEY=bf5672b1950e122c1b797146af33a32cd3c794615c8bb27ef5315cf38101aa1b

# LiteLLM integration
LITELLM_BASE_URL=http://litellm:4000

# API Keys
LANGFUSE_PUBLIC_KEY=pk_defaultkey
LANGFUSE_SECRET_KEY=sk_defaultsecret

# Langfuse ports
LANGFUSE_WEB_PORT=3001
LANGFUSE_WORKER_PORT=3030

# Langfuse credentials for app
APP_LANGFUSE_PUBLIC_KEY=pk_defaultkey
APP_LANGFUSE_SECRET_KEY=sk_defaultsecret
LANGFUSE_ENABLED=true

# =============================================================================
# LITELLM CONFIGURATION
# =============================================================================
LITELLM_MASTER_KEY=super-secret-key-change-in-production
LITELLM_PORT=4000
LITELLM_URL=http://litellm:4000

# =============================================================================
# CORE APPLICATION CONFIGURATION
# =============================================================================
# Services
LANGFUSE_HOST=http://langfuse-web:3000

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# Tracing
OTLP_EXPORTER_URL=http://jaeger:4318

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# Jaeger
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=14268

# =============================================================================
# FEATURES & TELEMETRY
# =============================================================================
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# DEVELOPMENT SETTINGS (Optional)
# =============================================================================
# Uncomment for development
# RELOAD=true
# DEBUG=true
